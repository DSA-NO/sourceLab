# Visualization bootstrap for the lab.
#
# Initializes the default geometry, source, and visual scene for interactive runs.

/control/macroPath .:macros:../macros

/control/verbose 0
/tracking/verbose 0
/run/verbose 0
/event/verbose 0

/run/initialize
/vis/open OGL
/control/execute vis.mac
/sourceLab/output/geometry water-annulus
/sourceLab/output/region phantom
/control/execute source-cs137.mac
/control/execute position-cs137-cylinder.mac
