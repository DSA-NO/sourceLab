# Simple visual smoke test for sourceLab.
#
# This is the minimal visualization example for interactive inspection of the
# water phantom, Cs-137 source, and stainless-steel shell.

/control/macroPath .:macros:../macros

# Minimal geometry setup.
/sourceLab/geometry/worldSize 30 cm
/sourceLab/geometry/phantomRadius 4 cm
/sourceLab/geometry/phantomHeight 5 cm
/sourceLab/geometry/sourceRadius 2.375 mm
/sourceLab/geometry/sourceShellThickness 0.8 mm

# Keep the run in a clean visual smoke-test state.
/run/initialize
/vis/open OGL
/control/execute vis.mac

# Source composition pattern and a short beam for easy viewing.
/control/execute source-co60.mac

/gps/pos/type Point
/gps/pos/centre 0 0 -10 cm
/gps/ang/type iso

/run/printProgress 1
/run/beamOn 5
