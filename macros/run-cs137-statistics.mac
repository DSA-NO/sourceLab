# Ten million Cs-137 decays for a higher-statistics test.
# Radioactive decay physics is enabled by default.
# Run with: ./scripts/run-micromamba.sh run -t 16 -b run-cs137-statistics.mac

/sourceLab/geometry/worldSize 30 cm
/sourceLab/geometry/phantomHeight 5 cm
/sourceLab/geometry/sourceRadius 2.375 mm
/sourceLab/geometry/sourceShellThickness 0.8 mm
/control/macroPath .:macros:../macros

/sourceLab/output/tag cs137-statistics-10m
/sourceLab/output/geometry water-annulus
/sourceLab/output/region phantom
/sourceLab/output/depth 0 cm

/run/initialize

/control/execute source-cs137.mac
/control/execute position-cs137-cylinder.mac

/run/printProgress 1000000
/run/beamOn 10000000
