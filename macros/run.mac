/sourceLab/geometry/worldSize 30 cm
/sourceLab/geometry/phantomRadius 4 cm
/sourceLab/geometry/phantomHeight 5 cm
/sourceLab/geometry/sourceRadius 2.375 mm
/sourceLab/geometry/sourceShellThickness 0.8 mm

# Allow nested /control/execute to resolve source macros in root or build workflows.
/control/macroPath .:macros:../macros

# Output metadata
/sourceLab/output/tag run-simple
/sourceLab/output/geometry water-annulus
/sourceLab/output/region phantom
/sourceLab/output/depth 0 cm

/run/initialize

# Source composition pattern (shared style with doseLab)
/control/execute source-co60.mac

# Reference beam placement and direction
/gps/pos/type Point
/gps/pos/centre 0 0 -10 cm
/gps/ang/type iso

/run/beamOn 100
